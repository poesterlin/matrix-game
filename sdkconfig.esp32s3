# Baseline profile. Regenerate this file with ESP-IDF 6.0.2 menuconfig after
# confirming the exact board flash size and GPIO assignments.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_RF_INPUT_GPIO=7
CONFIG_RF_PULSE_MIN_US=1
CONFIG_LED_BRIGHTNESS=20
